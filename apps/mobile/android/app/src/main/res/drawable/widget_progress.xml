<?xml version="1.0" encoding="utf-8"?>
<!-- Barra do "encontro ativo": trilho cinza (aparece nos dois temas) e o degradê da marca. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#33808080" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#FFFFC48A" android:centerColor="#FFFF4FB0" android:endColor="#FFA35CFF" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>

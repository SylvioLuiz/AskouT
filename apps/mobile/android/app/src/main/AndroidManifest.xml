<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Volta do login da Google Agenda / Outlook no navegador: br.com.askout://agenda abre o app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="br.com.askout" />
            </intent-filter>

            <!--
              Convite (https://askout.com.br/convite/usuario) abre o app instalado. A verificação automática precisa do
              https://askout.com.br/.well-known/assetlinks.json com o SHA-256 da chave da Play (ver GOLIVE.md). Sem ela, a página
              do convite chama o app pelo intent:// (br.com.askout://convite/usuario) ou leva ao Google Play.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="askout.com.br" />
                <data android:pathPrefix="/convite/" />
            </intent-filter>

            <!--
              "Compartilhar com o AskouT" em outros apps: fotos, vídeos, PDF, documentos e links (texto). Abre a tela
              "Enviar para…" para escolher a conversa ou o amigo (ShareInPlugin).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/csv" />
            </intent-filter>

        </activity>

        <!-- Avisos (push) chegam no canal "notificacoes", de importância alta, para mostrar a prévia no topo da tela. O app cria o canal ao abrir. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="notificacoes" />

        <!-- Ícone pequeno (silhueta branca) e cor de destaque dos avisos montados pelo Firebase. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_askout" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!--
          Push: troca o serviço do plugin do Capacitor pelo do app, que faz o mesmo e, nas mensagens de conversa
          (push só com dados), monta a notificação com o campo "Responder". A resposta sai pelo ReplyReceiver.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".ReplyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".ReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".ArrivalDismissReceiver"
            android:exported="false" />

        <!--
          Widgets da tela inicial: próximo encontro, encontro ativo, agenda e amigos no NOW (br.com.askout.widgets).
          Buscam GET /me/widgets com a sessão que o app grava (WidgetsPlugin); o alarme redesenha quando um plano começa
          ou termina.
        -->
        <receiver
            android:name=".widgets.NextMeetupWidget"
            android:label="@string/widget_next_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver
            android:name=".widgets.ActiveMeetupWidget"
            android:label="@string/widget_active_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_active_info" />
        </receiver>
        <receiver
            android:name=".widgets.AgendaWidget"
            android:label="@string/widget_agenda_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>
        <receiver
            android:name=".widgets.NowFriendsWidget"
            android:label="@string/widget_now_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>
        <receiver
            android:name=".widgets.NowComboWidget"
            android:label="@string/widget_combo_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combo_info" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetUpdater$TickReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Fotos e vídeos vêm do seletor do próprio Android (o WebView recebe só o arquivo escolhido), então o app
      NÃO pede acesso à galeria inteira. A política do Google Play para fotos e vídeos recusa READ_MEDIA_* quando
      o seletor basta; os "remove" garantem que nenhum plugin traga essas permissões de volta.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- Flash (localização), fotos e mensagens de voz dentro do WebView. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Achar amigos na agenda (só celulares e e-mails, que viram código antes de sair do aparelho). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- O plugin de contatos (@capacitor-community/contacts) pede leitura e escrita juntas: sem esta linha a permissão nunca fica
         "concedida" e a busca falha com "Missing the following permissions in AndroidManifest.xml: WRITE_CONTACTS".
         O AskouT não grava nada na agenda; o Android mostra um pedido só, de Contatos. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Sincronizar agendas: lê só os horários ocupados das agendas que a pessoa escolher. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- O plugin de localização em segundo plano declara o GPS como obrigatório; isso tirava o app da loja em
         aparelhos sem GPS (tablets, Chromebooks). O app funciona com a localização por rede, então o GPS é opcional. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" tools:replace="android:required" />
</manifest>

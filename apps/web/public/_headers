# Cloudflare Pages. A página (index.html e as rotas do SPA) precisa ser conferida a cada visita: é ela que aponta
# para os arquivos de /assets do deploy atual. Os arquivos de /assets/* têm o hash no nome e recebem cache longo
# no _worker.js, que sobrescreve este cabeçalho.
/*
  Cache-Control: no-cache

# Universal Links do iPhone: a Apple lê este arquivo (sem extensão) e exige JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

# App Links do Android: o Google lê este arquivo e exige application/json (sem isto, se o arquivo faltar, o
# fallback do SPA devolve index.html como text/html e a verificação falha).
/.well-known/assetlinks.json
  Content-Type: application/json

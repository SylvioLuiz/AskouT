{
  "name": "@askout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/core/index.ts",
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:full": "tsc --noEmit -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "dev": "tsx watch --exclude \"**/node_modules/**\" --tsconfig tsconfig.build.json src/http/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http/main.js",
    "smoke": "node scripts/smoke.mjs",
    "seed:places": "tsx scripts/seed-sample-places.ts",
    "seed:demo": "tsx scripts/seed-demo-people.ts",
    "seed:review-venue": "tsx scripts/seed-review-venue.ts",
    "admin:promote": "tsx scripts/make-admin.ts"
  },
  "dependencies": {
    "@askout/availability-engine": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}

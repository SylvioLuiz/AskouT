# Copie para .env e ajuste. NUNCA commite o .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://askout:askout@localhost:5432/askout

# Gere cada um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Precisam ter 32+ caracteres e ser DIFERENTES entre si.
JWT_SECRET=
CODE_SECRET=

TOKEN_TTL_SECONDS=3600
# Origens do front end separadas por vírgula (sem "*"). Exemplo: http://localhost:5173
CORS_ORIGINS=
# Só "console" existe hoje (imprime o código no terminal; recusado em produção).
EMAIL_TRANSPORT=console

# Somente para os testes de contrato do Prisma. O banco PRECISA terminar em _test:
# os testes APAGAM todos os dados dele.
# ASKOUT_TEST_DATABASE_URL=postgresql://askout:askout@localhost:5432/askout_test

# Aviso fora do app (Web Push). O "npm run update" gera o par de chaves sozinho e grava aqui.
# Sem as duas chaves o push fica desligado; o sino dentro do app continua funcionando.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contato exigido pelo padrão (mailto: ou https://). Opcional.
# VAPID_SUBJECT=mailto:voce@exemplo.com

# Entrar com Google / Apple. Sem o ID, o botão correspondente não aparece.
# Google: ID do cliente "Aplicativo da Web" (Google Cloud > APIs e serviços > Credenciais), com a origem do site em "Origens JavaScript autorizadas".
GOOGLE_CLIENT_ID=
# Apple: "Services ID" (developer.apple.com > Identifiers), com o domínio do site (HTTPS) e a URL de retorno cadastrados. Não funciona em localhost.
APPLE_CLIENT_ID=

# Impulsionamento (anúncio pago de eventos e locais).
# Chave geral do impulsionamento pago. DESLIGADA por padrão: nenhum pedido novo é aceito e a tela mostra "em breve".
# Para experimentar em desenvolvimento: PAYMENTS_ENABLED=true (usa o pagamento de teste, que não cobra nada).
# PAYMENTS_ENABLED=false
# Fora de produção o pagamento de TESTE ("sandbox") já vem ligado (o botão "simular pagamento" libera o anúncio).
# Em produção é preciso um provedor real. Hoje: stripe (Pix e cartão pela página de pagamento da Stripe).
# PAYMENT_PROVIDER=sandbox
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Endereço público do site (para voltar da página de pagamento), sem barra no fim. https em produção.
# PUBLIC_WEB_URL=https://askout.com.br
# Valor por dia em centavos de real (padrão 1500 = R$ 15,00).
# BOOST_PRICE_PER_DAY_CENTS=1500
# Valor por dia na compra dentro do app (App Store/Google Play), que deve bater com a tabela de preços da loja. Padrão: o da web.
# BOOST_STORE_PRICE_PER_DAY_CENTS=1500

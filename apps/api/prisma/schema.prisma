// AskouT — modelo de dados (Fases 1 e 2). Posts, locais/eventos e moderação entram em migrations próprias.
// ATENÇÃO: ainda não validado com `prisma validate` (sem rede no ambiente de geração).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
}

enum UserRole {
  USER
  VENUE_OWNER
  ADMIN
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum AvailabilityState {
  AVAILABLE
  PARTIAL
  UNAVAILABLE
}

enum CalendarProvider {
  GOOGLE
  APPLE
}

enum CalendarConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum MeetingStatus {
  PLANNING
  CONFIRMED
  CANCELLED
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  MAYBE
  DECLINED
  AWAITING
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum FlashInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
  ENDED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum EventKind {
  DIGITAL
  SHOW
  CINEMA
  THEATER
  EXHIBITION
  GASTRONOMY
  NIGHT
  OTHER
}

enum SuggestionResponse {
  ACCEPTED
  DECLINED
}

/// Bytes de uma mensagem de voz (até 600 KB; a API confere antes). Só quem está na conversa consegue ouvir.
model MessageAudio {
  messageId String @id @db.Uuid
  mime      String
  data      Bytes

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum MessageKind {
  TEXT
  SUGGESTION
  MEETUP
  SYSTEM
  EVENT
  AUDIO
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile  Profile?
  settings UserSettings?

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")
  blocksMade Block[] @relation("Blocker")
  blockedBy  Block[] @relation("Blocked")

  availabilitySlots   AvailabilitySlot[]
  calendarConnections CalendarConnection[]

  organizedMeetings     Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]

  ownedGroups  Group[]       @relation("GroupOwner")
  groupMembers GroupMember[]

  conversationParticipations ConversationParticipant[]
  messages                   Message[]

  flashSessions       FlashSession[]
  flashInvitesSent    FlashInvite[]   @relation("FlashInviteFrom")
  flashInvitesReceived FlashInvite[]  @relation("FlashInviteTo")
  flashPositions      FlashPosition[]
  flashHides          FlashHidden[]   @relation("FlashHiddenOwner")
  flashHiddenFrom     FlashHidden[]   @relation("FlashHiddenOther")
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  postedEvents      PostedEvent[]
  photo             ProfilePhoto?
  posts             Post[]
  postTags          PostTag[]
  postLikes         PostLike[]    @relation("PostLikes")
  postComments      PostComment[] @relation("PostComments")
  postReports       PostReport[]  @relation("PostReports")
  conversationReports  ConversationReport[] @relation("ConversationReports")
  conversationReported ConversationReport[] @relation("ConversationReported")
  postHidden        PostHidden[]  @relation("PostHidden")
}

model Profile {
  userId      String  @id @db.Uuid
  username    String  @unique // sempre salvo em minúsculas pela aplicação
  displayName String
  bio         String?
  avatarUrl   String?
  isPrivate   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  userId       String @id @db.Uuid
  timeZone     String @default("America/Sao_Paulo")
  notifyPrefs  Json   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId String       @db.Uuid
  followeeId String       @db.Uuid
  status     FollowStatus @default(ACCEPTED)
  createdAt  DateTime     @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model AvailabilitySlot {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  state          AvailabilityState
  recurrenceRule String? // RRULE; expandida antes de chamar o motor
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

model CalendarConnection {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @db.Uuid
  provider       CalendarProvider
  status         CalendarConnectionStatus @default(ACTIVE)
  refreshTokenEnc String? // criptografado em repouso; nunca em texto puro
  lastSyncAt     DateTime?
  createdAt      DateTime                 @default(now())

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  busyIntervals CalendarBusyInterval[]

  @@index([userId])
}

// Somente início e fim. Nunca título, descrição ou participantes do compromisso.
model CalendarBusyInterval {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startsAt])
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members GroupMember[]
  meetings Meeting[]
  conversation Conversation?
}

model GroupMember {
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  organizerId String        @db.Uuid
  groupId     String?       @db.Uuid
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      MeetingStatus @default(PLANNING)
  /// Evento do AskouT a que o encontro está ligado (nulo se o evento for apagado; título e horário ficam aqui).
  eventId        String?    @db.Uuid
  /// Conversa onde o encontro vive: a 1 a 1 (um convidado) ou a do grupo (vários).
  conversationId String?    @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  event        PlaceEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages     Message[]
  participants MeetingParticipant[]
  dateOptions  MeetingDateOption[]

  @@index([organizerId])
  @@index([groupId])
  @@index([eventId])
  @@index([conversationId])
}

model MeetingParticipant {
  meetingId String              @db.Uuid
  userId    String              @db.Uuid
  status    ParticipationStatus @default(INVITED)
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId, status])
}

model MeetingDateOption {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Conversation {
  id      String           @id @default(uuid()) @db.Uuid
  type    ConversationType
  groupId String?          @unique @db.Uuid
  /// Só nas conversas DIRECT: "<menor id>:<maior id>" da dupla, para existir uma única conversa por par.
  directKey String?        @unique
  createdAt DateTime       @default(now())

  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  meetings     Meeting[]
  reports      ConversationReport[]
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  /// "Limpar conversa": mensagens até esse instante não aparecem para essa pessoa.
  clearedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

/// Denúncia de conversa. `evidence` guarda as últimas mensagens de texto, só para a análise da equipe.
model ConversationReport {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  reporterId     String   @db.Uuid
  reportedUserId String?  @db.Uuid
  reason         String
  details        String?
  evidence       String   @default("")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ConversationReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reported     User?        @relation("ConversationReported", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, reporterId])
  @@index([createdAt])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  kind           MessageKind @default(TEXT)
  body           String
  /// Cartão de sugestão de lugar/evento (kind = SUGGESTION); texto simples em `body` serve de reserva.
  suggestion     Json?
  /// Resposta de quem recebeu o cartão (aceitar ou recusar o lugar). Nula enquanto não respondeu.
  response       SuggestionResponse?
  respondedAt    DateTime?
  /// Cartão de encontro (kind = MEETUP).
  meetupId       String?  @db.Uuid
  /// Evento compartilhado na conversa (kind = EVENT).
  eventId        String?  @db.Uuid
  /// Duração da mensagem de voz em ms (kind = AUDIO); os bytes ficam em MessageAudio.
  audioMs        Int?
  createdAt      DateTime @default(now())

  audio        MessageAudio?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  meetup       Meeting?     @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  event        PlaceEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([eventId])
  @@index([meetupId])
}

model FlashSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startsAt  DateTime  @default(now())
  expiresAt DateTime // obrigatório: todo Flash expira
  endedAt   DateTime? // preenchido quando a pessoa desliga antes do fim
  note      String? // recado curto opcional

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// Convite entre dois amigos com Flash ligado. ACCEPTED é o encontro: só nele a posição é compartilhada.
model FlashInvite {
  id          String            @id @default(uuid()) @db.Uuid
  fromUserId  String            @db.Uuid
  toUserId    String            @db.Uuid
  status      FlashInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  endedAt     DateTime?

  from      User            @relation("FlashInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User            @relation("FlashInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  positions FlashPosition[]

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

// Última posição de cada pessoa num encontro. Sem histórico: o upsert substitui a anterior.
model FlashPosition {
  inviteId  String   @db.Uuid
  userId    String   @db.Uuid
  lat       Float
  lng       Float
  accuracyM Float?
  updatedAt DateTime

  invite FlashInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
}

// Ocultação do Flash entre duas pessoas, do ponto de vista de `ownerId`: não ver o Flash dela e/ou não deixar ela ver o meu.
model FlashHidden {
  ownerId    String   @db.Uuid
  otherId    String   @db.Uuid
  hideTheirs Boolean  @default(false)
  hideMine   Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner User @relation("FlashHiddenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  other User @relation("FlashHiddenOther", fields: [otherId], references: [id], onDelete: Cascade)

  @@id([ownerId, otherId])
  @@index([otherId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Foto de perfil enviada pela pessoa (já reduzida pelo app). `Profile.avatarUrl` aponta para /users/:id/avatar.
model ProfilePhoto {
  userId    String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Evento que a pessoa decidiu postar no próprio perfil.
model PostedEvent {
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event PlaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId, createdAt])
}

// Inscrição de um navegador/aparelho para Web Push. O endpoint é único: pertence a uma pessoa só.
model PushSubscription {
  endpoint  String   @id
  userId    String   @db.Uuid
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cadastro aguardando o código enviado por e-mail. A conta (User + Profile) só nasce na confirmação.
// Guarda hashes: nunca a senha nem o código. Linhas expiradas devem ser limpas por uma rotina periódica.
model PendingSignup {
  email        String   @id // minúsculo
  username     String
  displayName  String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0) // incrementar de forma atômica (attempts: { increment: 1 })
  sendCount    Int      @default(1)
  lastSentAt   DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// Local físico (bar, café, casa de show). Por enquanto cadastrado à mão ou por seed de TESTE (isSample);
/// o painel de bares passa a criar e editar isto.
model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  category  String?
  lat       Float
  lng       Float
  /// Dado de teste, nunca apresentado como real.
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PlaceEvent[]

  @@index([lat, lng])
}

/// Evento num local, com data e hora. Chamado PlaceEvent para não colidir com a palavra "Event" em outros contextos.
model PlaceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  kind        EventKind @default(OTHER)
  isFree      Boolean   @default(false)
  /// Endereço https de uma imagem fornecida por quem criou o evento (nunca copiada do Google).
  imageUrl    String?
  /// Hashtags em minúsculas, sem "#" e sem acento.
  tags        String[]  @default([])
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  meetings Meeting[]
  messages Message[]
  posts    PostedEvent[]

  @@index([startsAt])
  @@index([venueId])
  @@index([kind])
}

// Post com fotos (enviadas pela pessoa ou a foto de um lugar) e legenda opcional.
model Post {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @db.Uuid
  caption      String?
  placeName    String?
  placeAddress String?
  /// Preenchidos quando o post é um evento criado pela pessoa.
  eventTitle    String?
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  archivedAt    DateTime?
  editedAt      DateTime?
  createdAt    DateTime @default(now())

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images PostImage[]
  tags   PostTag[]
  likes    PostLike[]
  comments PostComment[]
  reports  PostReport[]
  hiddenBy PostHidden[]

  @@index([authorId, createdAt])
}

// Foto enviada: `mime` e `data`. Foto do lugar: só `placePhotoRef` (o servidor busca no Google na hora de mostrar).
model PostImage {
  id               String  @id @default(uuid()) @db.Uuid
  postId           String  @db.Uuid
  position         Int
  mime             String?
  data             Bytes?
  placePhotoRef    String?
  placePhotoAuthor String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
}

// Marcação de uma pessoa num post. Só vale no perfil e no feed dela depois que ela aceita.
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("PostComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Denúncia de post: uma por pessoa e post. Quem revisa é o painel de administração (fase seguinte).
model PostReport {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  details    String?
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("PostReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([createdAt])
}

/// "Não tenho interesse": o post some das listas dessa pessoa.
model PostHidden {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostHidden", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostTag {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, status])
}

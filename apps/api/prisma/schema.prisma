// AskouT — modelo de dados (Fases 1 e 2). Posts, locais/eventos e moderação entram em migrations próprias.
// ATENÇÃO: ainda não validado com `prisma validate` (sem rede no ambiente de geração).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
}

enum UserRole {
  USER
  VENUE_OWNER
  ADMIN
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum AvailabilityState {
  AVAILABLE
  PARTIAL
  UNAVAILABLE
}

enum CalendarProvider {
  GOOGLE
  APPLE
  DEVICE // agenda do celular (lida pelo app; traz as contas Google, Outlook, iCloud ligadas no aparelho)
  MICROSOFT // Outlook / Microsoft 365 (OAuth, Microsoft Graph)
  ICS // link iCal privado (Outlook, iCloud, Google ou qualquer agenda que publique .ics)
}

enum CalendarConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum MeetingStatus {
  PLANNING
  CONFIRMED
  CANCELLED
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  MAYBE
  DECLINED
  AWAITING
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum FlashInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
  ENDED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum EventKind {
  DIGITAL
  SHOW
  CINEMA
  THEATER
  EXHIBITION
  GASTRONOMY
  NIGHT
  OUTDOOR
  SPORT
  OTHER
}

enum SuggestionResponse {
  ACCEPTED
  DECLINED
  /// Quem sugeriu cancelou a sugestão.
  CANCELED
}

/// Bytes de uma mensagem de voz (até 600 KB; a API confere antes). Só quem está na conversa consegue ouvir.
/// Foto ou vídeo enviado na conversa (kind IMAGE ou VIDEO).
model MessageMedia {
  messageId String @id @db.Uuid
  mime      String
  data      Bytes

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

/// Reação com emoji a uma mensagem: uma por pessoa.
model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

/// Quem já ouviu a mensagem de voz (o "ouvido" do balão, como no WhatsApp). Uma linha por pessoa.
model MessageAudioPlay {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  playedAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageAudio {
  messageId String @id @db.Uuid
  mime      String
  data      Bytes

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum MessageKind {
  TEXT
  SUGGESTION
  MEETUP
  SYSTEM
  EVENT
  AUDIO
  IMAGE
  VIDEO
  /// Documento (PDF, Word, Excel, PowerPoint, texto). O nome do arquivo fica no body; os bytes, em MessageMedia.
  FILE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  /// Informada uma vez, para liberar o Flash (18+). Não aparece no perfil público.
  birthDate    DateTime?  @db.Date
  /// Aceite dos Termos de Uso e da Política de Privacidade no cadastro (e a versão aceita).
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Quando a pessoa terminou (ou pulou) o tutorial inicial; o app só o mostra enquanto estiver vazio.
  onboardedAt     DateTime?
  /// Gostos de rolê escolhidos no cadastro e editáveis nas configurações (ids como BAR, NIGHT, SHOW). Vazio = gosta de tudo.
  tastes          String[]  @default([])
  /// Conta criada pelo Google/Apple que ainda não escolheu o nome de usuário nem informou a data de nascimento: o app só mostra essa etapa até concluir.
  profilePending  Boolean   @default(false)
  /// Criada pelo Google/Apple e sem senha definida: não dá para desligar a última conta vinculada até criar uma senha.
  passwordless    Boolean   @default(false)
  /// Celular (E.164, ex.: +5511987654321). Privado: nunca aparece no perfil, só serve para amigos acharem a pessoa na agenda.
  phone           String?   @unique
  /// SHA-256 (hex) do celular, comparado com os códigos que o app manda da agenda de quem procura amigos.
  phoneHash       String?   @unique
  /// Quando o celular atual foi confirmado por SMS. Só celular confirmado entra sem senha (código por SMS). Trocar o número apaga.
  phoneVerifiedAt DateTime?

  profile  Profile?
  settings UserSettings?
  passwordReset PasswordReset?
  phoneCode     PhoneCode?
  mfa           UserMfa?
  boosts        Boost[]
  venueOffers   VenueOffer[]
  dwells        ContentDwell[]
  consentEvents ConsentEvent[]
  cloakroomTickets CloakroomTicket[]

  referralsMade   Referral[] @relation("ReferralInviter")
  referralReceived Referral? @relation("ReferralInvitee")

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")
  datePollsOrganized     DatePoll[]             @relation("PollOrganizer")
  datePollParticipations DatePollParticipant[]
  datePollVotes          DatePollVote[]
  datePollConfirmations  DatePollConfirmation[]

  blocksMade Block[] @relation("Blocker")
  blockedBy  Block[] @relation("Blocked")

  availabilitySlots   AvailabilitySlot[]
  calendarConnections CalendarConnection[]
  externalIdentities  ExternalIdentity[]
  commentLikes        PostCommentLike[]    @relation("PostCommentLikes")
  eventStories        EventStory[]         @relation("EventStoryAuthor")
  storyReports        EventStoryReport[]   @relation("EventStoryReports")
  storyLikes          EventStoryLike[]     @relation("EventStoryLikes")
  storyViews          EventStoryView[]     @relation("EventStoryViews")
  notificationSetting NotificationSetting? @relation("NotificationSettingUser")

  organizedMeetings     Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]

  userReportsMade     UserReport[] @relation("UserReportsMade")
  userReportsReceived UserReport[] @relation("UserReportsReceived")

  ownedGroups  Group[]       @relation("GroupOwner")
  groupMembers GroupMember[]
  groupInvites GroupInvite[] @relation("GroupInvitesReceived")

  conversationParticipations ConversationParticipant[]
  messages                   Message[]
  messageReactions           MessageReaction[]
  messageAudioPlays          MessageAudioPlay[]

  flashSessions       FlashSession[]
  flashInvitesSent    FlashInvite[]   @relation("FlashInviteFrom")
  flashInvitesReceived FlashInvite[]  @relation("FlashInviteTo")
  flashPositions      FlashPosition[]
  flashHides          FlashHidden[]   @relation("FlashHiddenOwner")
  flashHiddenFrom     FlashHidden[]   @relation("FlashHiddenOther")
  flashAsksSent       FlashAsk[]      @relation("FlashAskFrom")
  flashAsksReceived   FlashAsk[]      @relation("FlashAskTo")
  storyHides          StoryHidden[]   @relation("StoryHiddenOwner")
  storyHiddenFrom     StoryHidden[]   @relation("StoryHiddenOther")
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  postedEvents      PostedEvent[]
  postedUserEvents  PostedUserEvent[] @relation("UserPostedUserEvents")
  photo             ProfilePhoto?
  posts             Post[]
  eventAttendances  EventAttendance[]
  albumMembers      AlbumMember[]
  albumPhotos       AlbumPhoto[]
  venueStories      VenueStory[]       @relation("VenueStoryAuthor")
  venueStoryReports VenueStoryReport[] @relation("VenueStoryReports")
  venueStoryMutes   VenueStoryMute[]
  eventReminderChoices EventReminderChoice[]
  venueStoryPref    VenueStoryPref?
  feedPosts         FeedPost[]        @relation("FeedPostAuthor")
  feedComments      FeedComment[]     @relation("FeedCommentAuthor")
  feedReactions     FeedReaction[]    @relation("FeedReactionUser")
  feedCommentReactions FeedCommentReaction[] @relation("FeedCommentReactionUser")
  feedReportsMade      FeedReport[]          @relation("FeedReportsMade")
  feedReportsReceived  FeedReport[]          @relation("FeedReportsReceived")
  postTags          PostTag[]
  eventInvitesReceived EventInvite[] @relation("EventInvitesReceived")
  eventInvitesSent     EventInvite[] @relation("EventInvitesSent")
  eventAdminOf         EventAdmin[]  @relation("EventAdmins")
  postLikes         PostLike[]    @relation("PostLikes")
  postComments      PostComment[] @relation("PostComments")
  postReports       PostReport[]  @relation("PostReports")
  conversationReports  ConversationReport[] @relation("ConversationReports")
  conversationReported ConversationReport[] @relation("ConversationReported")
  postHidden        PostHidden[]  @relation("PostHidden")
  ownedVenues       Venue[]       @relation("VenueOwner")
  venueClaims       VenueClaim[]  @relation("ClaimUser")
  venueManagerships VenueManager[] @relation("VenueManagerUser")
  venueFollows      VenueFollow[]
  region            UserRegion?
  venueRatings      VenueRating[]
  venueCheckins     VenueCheckin[]
  reviewedClaims    VenueClaim[]  @relation("ClaimReviewer")
  guestListEntries GuestListEntry[]
}

model Profile {
  userId      String  @id @db.Uuid
  username    String  @unique // sempre salvo em minúsculas pela aplicação
  displayName String
  bio         String?
  avatarUrl   String?
  isPrivate   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  userId       String @id @db.Uuid
  timeZone     String @default("America/Sao_Paulo")
  notifyPrefs  Json   @default("{}")
  /// A pessoa escolheu mostrar os horários da agenda para os amigos (e entrar nos horários em comum). Começa desligado.
  shareAvailability Boolean @default(false)
  /// Perfil público aceita mensagens de quem ele não segue direto na caixa de conversas (sem virar solicitação).
  openDms Boolean @default(false)
  /// Amigos (e quem conversa com a pessoa) veem a bolinha verde quando ela está com o app aberto. Desligado, ela também não vê a dos outros.
  showOnline Boolean @default(true)
  /// Quantas vezes o app pediu para cadastrar o celular (para de pedir depois de algumas) e quando foi a última.
  phonePromptCount Int       @default(0)
  phonePromptAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId String       @db.Uuid
  followeeId String       @db.Uuid
  status     FollowStatus @default(ACCEPTED)
  createdAt  DateTime     @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model AvailabilitySlot {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  state          AvailabilityState
  recurrenceRule String? // RRULE; expandida antes de chamar o motor
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

model CalendarConnection {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @db.Uuid
  provider       CalendarProvider
  status         CalendarConnectionStatus @default(ACTIVE)
  refreshTokenEnc String? // criptografado em repouso; nunca em texto puro
  sourceEnc      String? // link iCal (ICS), criptografado: o link privado dá acesso à agenda
  label          String? // nome para a pessoa reconhecer (ex.: "Google Agenda", "Agenda do celular")
  accountEmail   String? // conta Google ligada (uma conexão por conta)
  calendars      Json? // agendas da conexão: [{ id, name, selected, color, account }]
  lastError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime                 @default(now())

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  busyIntervals CalendarBusyInterval[]

  @@index([userId])
}

// Somente início e fim. Nunca título, descrição ou participantes do compromisso.
model CalendarBusyInterval {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startsAt])
  @@index([startsAt])
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String
  imageUrl  String?
  /// Grupo criado para um evento de pessoa (pela página do evento ou pela votação da data). Liga pelo ID: o nome do evento pode mudar.
  eventPostId String? @db.Uuid
  /// Grupo de amigos (turma): a pessoa só entra quando aceita o convite, e dentro dele se criam eventos que já convidam todos.
  community Boolean @default(false)
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id])
  eventPost Post?       @relation("EventGroups", fields: [eventPostId], references: [id], onDelete: SetNull)
  members GroupMember[]
  meetings Meeting[]
  conversation Conversation?
  invites GroupInvite[]

  @@index([eventPostId])
}

/// Convite pendente para entrar num grupo de amigos. Aceitar coloca a pessoa no grupo e apaga o convite; recusar só apaga.
model GroupInvite {
  groupId     String   @db.Uuid
  userId      String   @db.Uuid
  invitedById String?  @db.Uuid
  /// Quem convidou escolheu mostrar as mensagens anteriores do grupo a quem entrar. Falso: a pessoa só vê o que vier depois.
  shareHistory Boolean @default(true)
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupInvitesReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMember {
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  organizerId String        @db.Uuid
  groupId     String?       @db.Uuid
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      MeetingStatus @default(PLANNING)
  /// Evento do AskouT a que o encontro está ligado (nulo se o evento for apagado; título e horário ficam aqui).
  eventId        String?    @db.Uuid
  /// Conversa onde o encontro vive: a 1 a 1 (um convidado) ou a do grupo (vários).
  conversationId String?    @db.Uuid
  /// Evento criado por uma pessoa (post) de onde o encontro saiu. Liga pelo ID, nunca pelo nome: o nome pode mudar.
  eventPostId    String?    @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  eventPost    Post?                @relation("MeetingEventPost", fields: [eventPostId], references: [id], onDelete: SetNull)
  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  event        PlaceEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages     Message[]
  participants MeetingParticipant[]
  dateOptions  MeetingDateOption[]

  @@index([organizerId])
  @@index([groupId])
  @@index([eventId])
  @@index([eventPostId])
  @@index([conversationId])
}

model MeetingParticipant {
  meetingId String              @db.Uuid
  userId    String              @db.Uuid
  status    ParticipationStatus @default(INVITED)
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId, status])
}

model MeetingDateOption {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Conversation {
  id      String           @id @default(uuid()) @db.Uuid
  type    ConversationType
  groupId String?          @unique @db.Uuid
  /// Só nas conversas DIRECT: "<menor id>:<maior id>" da dupla, para existir uma única conversa por par.
  directKey String?        @unique
  createdAt DateTime       @default(now())
  /// Só DIRECT: solicitação de mensagem pendente para esta pessoa (alguém que ela não segue escreveu). Nula = conversa normal.
  requestToId       String?   @db.Uuid
  /// Quem recebeu a solicitação recusou (some para ela até chegar mensagem nova).
  requestDeclinedAt DateTime?
  /// Quem recebeu aceitou a solicitação: a conversa fica liberada nos dois sentidos.
  acceptedAt        DateTime?
  /// Só DIRECT: conversa com a página de um local (cliente ↔ dono). Chave "venue:<local>:<cliente>", separada da conversa pessoal da dupla.
  venueId           String?   @db.Uuid

  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  meetings     Meeting[]
  datePolls    DatePoll[]
  reports      ConversationReport[]
  venue        Venue?                    @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([venueId])
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  /// "Limpar conversa": mensagens até esse instante não aparecem para essa pessoa.
  clearedAt      DateTime?
  /// Conversa fixada no topo da lista (só para essa pessoa).
  pinnedAt       DateTime?
  /// Sem avisos de mensagem nova (só para essa pessoa).
  muted          Boolean   @default(false)
  /// Cor escolhida para a conversa (só para essa pessoa); nula = cor padrão do app.
  color          String?
  /// Saiu do grupo de amigos (ou o grupo foi encerrado): continua vendo as mensagens até aqui, sem enviar, até excluir a conversa.
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

/// Denúncia de conversa. `evidence` guarda as últimas mensagens de texto, só para a análise da equipe.
model ConversationReport {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  reporterId     String   @db.Uuid
  reportedUserId String?  @db.Uuid
  reason         String
  details        String?
  evidence       String   @default("")
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?  @db.Uuid
  resolution     String?
  resolutionNote String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ConversationReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reported     User?        @relation("ConversationReported", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, reporterId])
  @@index([createdAt])
  @@index([resolvedAt])
}

/// Denúncia de um perfil (nome, foto, descrição) ou de um comentário. `evidence` guarda o texto no momento da denúncia.
/// `dedupeKey` (denunciante + alvo + tipo + comentário) impede denunciar a mesma coisa duas vezes.
model UserReport {
  id             String    @id @default(uuid()) @db.Uuid
  dedupeKey      String    @unique
  kind           String // PROFILE | COMMENT
  reporterId     String    @db.Uuid
  reportedUserId String    @db.Uuid
  commentId      String?
  reason         String
  details        String?
  evidence       String    @default("")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  resolution     String?
  resolutionNote String?

  reporter User @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("UserReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([resolvedAt])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  kind           MessageKind @default(TEXT)
  body           String
  /// Cartão de sugestão de lugar/evento (kind = SUGGESTION); texto simples em `body` serve de reserva.
  suggestion     Json?
  /// Resposta de quem recebeu o cartão (aceitar ou recusar o lugar). Nula enquanto não respondeu.
  response       SuggestionResponse?
  respondedAt    DateTime?
  /// Cartão de encontro (kind = MEETUP).
  meetupId       String?  @db.Uuid
  /// Evento compartilhado na conversa (kind = EVENT).
  eventId        String?  @db.Uuid
  /// Evento criado por uma pessoa (um post), compartilhado na conversa (kind = EVENT, no lugar de eventId).
  postEventId    String?  @db.Uuid
  /// Duração da mensagem de voz em ms (kind = AUDIO); os bytes ficam em MessageAudio.
  audioMs        Int?
  /// GIF da Giphy (mensagem de texto com `body` "GIF"): id e endereço (https, servidor da Giphy).
  gifId          String?
  gifUrl         String?
  /// Story respondido ou reagido (a resposta leva o story anexado). Sem chave estrangeira: o story expira.
  storyId        String?  @db.Uuid
  /// Perfil compartilhado (mensagem de texto com o cartão do perfil). Sem chave estrangeira: conta apagada vira "Perfil indisponível".
  profileUserId  String?  @db.Uuid
  /// Mensagem respondida (na mesma conversa).
  replyToId      String?  @db.Uuid
  /// Apagada por quem enviou: some para todos.
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  audio        MessageAudio?
  media        MessageMedia?
  reactions    MessageReaction[]
  audioPlays   MessageAudioPlay[]
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  meetup       Meeting?     @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  event        PlaceEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postEvent    Post?        @relation("MessagePostEvent", fields: [postEventId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([postEventId])
  @@index([eventId])
  @@index([meetupId])
}

model FlashSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startsAt  DateTime  @default(now())
  expiresAt DateTime // obrigatório: todo Flash expira
  endedAt   DateTime? // preenchido quando a pessoa desliga antes do fim
  note      String? // recado curto opcional
  /// Região aproximada (arredondada para ~1 km) de quando ligou: só para ordenar "mais perto". Nunca sai na resposta
  /// e é apagada quando o NOW termina.
  areaLat   Float?
  areaLng   Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// Convite entre dois amigos com Flash ligado. ACCEPTED é o encontro: só nele a posição é compartilhada.
model FlashInvite {
  id          String            @id @default(uuid()) @db.Uuid
  fromUserId  String            @db.Uuid
  toUserId    String            @db.Uuid
  status      FlashInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  endedAt     DateTime?
  // Lugar escolhido por um dos dois no mapa do encontro (sem chave estrangeira: some com o encontro).
  destinationName     String?
  destinationLat      Float?
  destinationLng      Float?
  destinationChosenBy String?   @db.Uuid
  destinationChosenAt DateTime?
  // Cada um escolhe ao convidar/aceitar: true = o outro só vê a posição arredondada (~1 km).
  fromApprox Boolean @default(false)
  toApprox   Boolean @default(false)
  // Cada um escolhe durante o encontro: true = o outro acompanha a chegada dele nas notificações do celular.
  fromArrival Boolean @default(false)
  toArrival   Boolean @default(false)

  from      User            @relation("FlashInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User            @relation("FlashInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  positions FlashPosition[]

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

// Última posição de cada pessoa num encontro. Sem histórico: o upsert substitui a anterior.
model FlashPosition {
  inviteId  String   @db.Uuid
  userId    String   @db.Uuid
  lat       Float
  lng       Float
  accuracyM Float?
  updatedAt DateTime

  invite FlashInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
}

// Ocultação do Flash entre duas pessoas, do ponto de vista de `ownerId`: não ver o Flash dela e/ou não deixar ela ver o meu.
model FlashHidden {
  ownerId    String   @db.Uuid
  otherId    String   @db.Uuid
  hideTheirs Boolean  @default(false)
  hideMine   Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner User @relation("FlashHiddenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  other User @relation("FlashHiddenOther", fields: [otherId], references: [id], onDelete: Cascade)

  @@id([ownerId, otherId])
  @@index([otherId])
}

// "Perguntar se está livre": `askerId` perguntou a `targetId`. Uma linha por dupla (a mais recente); some quando a
// pessoa liga o NOW (quem perguntou é avisado) ou depois de 24 h.
model FlashAsk {
  askerId   String   @db.Uuid
  targetId  String   @db.Uuid
  createdAt DateTime @default(now())

  asker  User @relation("FlashAskFrom", fields: [askerId], references: [id], onDelete: Cascade)
  target User @relation("FlashAskTo", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([askerId, targetId])
  @@index([targetId])
}

// Ocultação de stories entre duas pessoas, do ponto de vista de `ownerId`: não ver os stories dela e/ou não deixar ela ver os meus.
model StoryHidden {
  ownerId    String   @db.Uuid
  otherId    String   @db.Uuid
  hideTheirs Boolean  @default(false)
  hideMine   Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner User @relation("StoryHiddenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  other User @relation("StoryHiddenOther", fields: [otherId], references: [id], onDelete: Cascade)

  @@id([ownerId, otherId])
  @@index([otherId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// O que a pessoa silenciou no push: tudo, só conversas ou só eventos (encontros). O aviso continua no sino.
model NotificationSetting {
  userId     String   @id @db.Uuid
  muteAll    Boolean  @default(false)
  muteChats  Boolean  @default(false)
  muteEvents Boolean  @default(false)
  /// Som do push por grupo (ver apps/api/src/core/notification-sounds.ts): `padrao`, `silencioso` ou um som do app.
  soundChats   String @default("padrao")
  soundInvites String @default("padrao")
  soundArrival String @default("padrao")
  soundOther   String @default("padrao")
  /// Lembretes de evento escolhidos (`manha,30m`; vazio = nenhum). Nulo: segue o padrão ("É hoje!" e 30 min antes).
  eventReminders   String?
  /// Fuso do aparelho, para o "É hoje!" sair de manhã na hora da pessoa. Nulo: America/Sao_Paulo.
  reminderTimeZone String?
  updatedAt  DateTime @default(now())

  user User @relation("NotificationSettingUser", fields: [userId], references: [id], onDelete: Cascade)
}

// Foto de perfil enviada pela pessoa (já reduzida pelo app). `Profile.avatarUrl` aponta para /users/:id/avatar.
model ProfilePhoto {
  userId    String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Evento que a pessoa decidiu postar no próprio perfil.
// Evento criado por outra pessoa que alguém repostou no próprio perfil.
model PostedUserEvent {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation("UserPostedUserEvents", fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model PostedEvent {
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event PlaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId, createdAt])
}

// Inscrição de um navegador/aparelho para Web Push. O endpoint é único: pertence a uma pessoa só.
model PushSubscription {
  endpoint  String   @id
  userId    String   @db.Uuid
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  /// O app do aparelho mostra o campo "Responder" na notificação (no Android, o push vai só com dados).
  replyable Boolean  @default(false)
  /// O app do aparelho tem os sons do AskouT (no Android, os canais de cada som). Sem isso, só o som padrão.
  sounds    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cadastro aguardando o código enviado por e-mail. A conta (User + Profile) só nasce na confirmação.
// Guarda hashes: nunca a senha nem o código. Linhas expiradas devem ser limpas por uma rotina periódica.
/// Pedido de nova senha em andamento (um por pessoa). `channel` prepara o envio por SMS no futuro.
model PasswordReset {
  userId     String   @id @db.Uuid
  channel    String   @default("EMAIL")
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sendCount  Int      @default(1)
  lastSentAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Código por SMS em andamento (entrar pelo celular ou confirmar o número): um por pessoa, guarda só o HMAC do código.
model PhoneCode {
  userId     String   @id @db.Uuid
  /// LOGIN ou VERIFY
  purpose    String
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sendCount  Int      @default(1)
  lastSentAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Verificação em duas etapas por app autenticador (TOTP). Sem enabledAt, a configuração ainda não foi confirmada.
model UserMfa {
  userId             String    @id @db.Uuid
  /// Segredo TOTP cifrado com AES-256-GCM (chave derivada do CODE_SECRET).
  secretSealed       String
  enabledAt          DateTime?
  /// HMAC dos códigos de recuperação ainda não usados.
  recoveryCodeHashes String[]  @default([])
  lastUsedStep       Int       @default(-1)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingSignup {
  email        String   @id // minúsculo
  username     String
  displayName  String
  passwordHash String
  birthDate    DateTime @db.Date
  termsVersion String
  /// Marcou "quero receber novidades por e-mail" no cadastro (opcional).
  marketingEmail Boolean @default(false)
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0) // incrementar de forma atômica (attempts: { increment: 1 })
  sendCount    Int      @default(1)
  lastSentAt   DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// Local físico (bar, café, casa de show). Por enquanto cadastrado à mão ou por seed de TESTE (isSample);
/// o painel de bares passa a criar e editar isto.
model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  category  String?
  lat       Float
  lng       Float
  /// Dado de teste, nunca apresentado como real.
  isSample  Boolean  @default(false)
  /// Quem administra o local (pedido de reivindicação aprovado por um admin).
  ownerId   String?  @db.Uuid
  /// Perfil do estabelecimento (editável por quem administra).
  description String?
  /// JSON com 7 posições (domingo a sábado): {open, close} ou null (fechado).
  hoursJson   String?
  /// https ou `/venues/:id/cover?v=` (capa enviada, bytes em VenueCover).
  coverUrl    String?
  /// https ou `/venues/:id/logo?v=` (logo enviada, bytes em VenueLogo).
  logoUrl     String?
  /// @ do Instagram do local, sem "@" e em minúsculas (ex.: "bardoze").
  instagram   String?
  /// "google:ID" quando o local entrou de uma fonte externa; único.
  externalKey String?  @unique
  photoRef    String?
  photoAuthor String?
  /// Organização (bateria, atlética, centro acadêmico...) em vez de estabelecimento. Pedida por quem a representa e
  /// aprovada por um admin; enquanto não tem dono, fica fora das buscas.
  isOrganization Boolean @default(false)
  /// Local criado do zero por alguém no app (pedido com documento). Enquanto não tem dono, fica fora das buscas.
  isUserCreated Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User?        @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events PlaceEvent[]
  claims VenueClaim[]
  managers VenueManager[]
  cover  VenueCover?
  logo   VenueLogo?
  calendar       VenueCalendar?
  calendarDrafts VenueCalendarDraft[]
  followers VenueFollow[]
  stories   VenueStory[]
  conversations Conversation[]
  storyMutes VenueStoryMute[]
  ratings   VenueRating[]
  checkinCode VenueCheckinCode?
  checkins  VenueCheckin[]
  posts  Post[]
  comments PostComment[]
  /// Quem pode publicar no feed da página do rolê.
  feedPolicy FeedPolicy @default(OWNER_ONLY)
  feedPosts  FeedPost[]

  @@index([lat, lng])
  @@index([ownerId])
  boosts Boost[]
  offers VenueOffer[]
}

enum VenueManagerStatus {
  PENDING
  ACCEPTED
}

/// Administrador adicional do local: convidado pelo dono e só vale depois do aceite. Edita perfil, eventos, agenda, posts e
/// chapelaria; não mexe na equipe nem impulsiona (isso é só do dono, `Venue.ownerId`).
model VenueManager {
  venueId     String             @db.Uuid
  userId      String             @db.Uuid
  status      VenueManagerStatus @default(PENDING)
  invitedById String             @db.Uuid
  createdAt   DateTime           @default(now())
  acceptedAt  DateTime?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation("VenueManagerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([venueId, userId])
  @@index([userId, status])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pedido de uma pessoa para administrar um local. O documento (PDF ou imagem, até 2 MB) só o admin vê.
model VenueClaim {
  id           String      @id @default(uuid()) @db.Uuid
  venueId      String      @db.Uuid
  userId       String      @db.Uuid
  status       ClaimStatus @default(PENDING)
  note         String?
  documentMime String
  document     Bytes
  reviewNote   String?
  reviewedBy   String?     @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())

  venue    Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user     User  @relation("ClaimUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ClaimReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([venueId, status])
  @@index([status, createdAt])
}

/// Evento num local, com data e hora. Chamado PlaceEvent para não colidir com a palavra "Event" em outros contextos.
model PlaceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  kind        EventKind @default(OTHER)
  isFree      Boolean   @default(false)
  /// Endereço https de uma imagem fornecida por quem criou o evento (nunca copiada do Google).
  imageUrl    String?
  /// Hashtags em minúsculas, sem "#" e sem acento.
  tags        String[]  @default([])
  /// Link https para comprar ingresso (informado por quem criou o evento).
  ticketUrl   String?
  /// Quem pode publicar no feed do evento (o moderador é quem administra o local).
  feedPolicy  FeedPolicy @default(OWNER_ONLY)
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  meetings Meeting[]
  messages Message[]
  posts    PostedEvent[]
  attendees EventAttendance[]
  stories   EventStory[]
  cover    PlaceEventCover?
  feedPosts FeedPost[]
  cloakroom CloakroomSetting?
  cloakroomTickets CloakroomTicket[]
  guestList GuestList?
  hunterLink HunterEventLink?

  @@index([startsAt])
  @@index([venueId])
  @@index([kind])
}

// Post com fotos (enviadas pela pessoa ou a foto de um lugar) e legenda opcional.
model Post {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @db.Uuid
  caption      String?
  placeName    String?
  placeAddress String?
  /// Preenchidos quando o post é um evento criado pela pessoa.
  eventTitle    String?
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  eventKind     EventKind @default(OTHER)
  /// Evento criado pela pessoa: quem pode publicar no feed do evento.
  feedPolicy       FeedPolicy @default(OWNER_ONLY)
  /// Evento privado: some das listas e do perfil de quem não é o dono; só chega por cartão enviado numa conversa e ninguém o reposta.
  eventPrivate     Boolean @default(false)
  /// Respostas às configurações de evento da gestão: `[{optionId, value}]` (value é true/false ou texto).
  eventExtras      Json    @default("[]")
  archivedAt    DateTime?
  editedAt      DateTime?
  createdAt    DateTime @default(now())
  /// Post feito em nome de um estabelecimento (o autor é quem administra o local).
  venueId      String?  @db.Uuid
  /// Local do AskouT vinculado como rolê do post (escolhido na busca; pode ter sido criado a partir do Google).
  placeVenueId String?  @db.Uuid
  /// Evento ao qual o post (foto, vídeo ou só texto) está vinculado: id de um PlaceEvent ou de um Post que é evento. Sem chave estrangeira; se o evento sumir, o vínculo só deixa de aparecer.
  linkedEventId String? @db.Uuid
  /// Evento criado dentro de um grupo de amigos: id da conversa do grupo. Sem chave estrangeira; só quem está no grupo vê esse vínculo.
  originGroupId String? @db.Uuid

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  venue  Venue?      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  images PostImage[]
  tags   PostTag[]
  invites EventInvite[]
  admins  EventAdmin[]
  eventGroups Group[] @relation("EventGroups")
  likes    PostLike[]
  comments PostComment[]
  reports  PostReport[]
  hiddenBy PostHidden[]
  attendees EventAttendance[]
  stories   EventStory[]
  feedPosts  FeedPost[]
  sharedInMessages Message[] @relation("MessagePostEvent")
  repostedBy PostedUserEvent[]
  datePolls  DatePoll[] @relation("PollEventPost")
  meetings   Meeting[]  @relation("MeetingEventPost")
  shopping   EventShopping?

  @@index([authorId, createdAt])
  @@index([venueId, createdAt])
  @@index([linkedEventId, createdAt])
  @@index([originGroupId, createdAt])
}

// Foto enviada: `mime` e `data`. Foto do lugar: só `placePhotoRef` (o servidor busca no Google na hora de mostrar).
model PostImage {
  id               String  @id @default(uuid()) @db.Uuid
  postId           String  @db.Uuid
  position         Int
  mime             String?
  data             Bytes?
  placePhotoRef    String?
  placePhotoAuthor String?
  /// Quando o item é um vídeo: `mime`/`data` guardam a imagem de capa (assim toda tela que mostra foto continua valendo) e o vídeo fica aqui.
  videoMime        String?
  videoData        Bytes?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
}

// Marcação de uma pessoa num post. Só vale no perfil e no feed dela depois que ela aceita.
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  /// Pode ser vazio quando o comentário é só um GIF.
  body      String
  createdAt DateTime @default(now())
  /// Comentário feito como estabelecimento (quem administra, num post do próprio bar).
  venueId   String?  @db.Uuid
  /// GIF da Giphy anexado: id e endereço (https, servidor da Giphy).
  gifId     String?
  gifUrl    String?
  /// Resposta a outro comentário: sempre o comentário de cima da conversa (um nível só). Apagar o de cima solta as respostas.
  parentId  String?  @db.Uuid

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  venue  Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  author User @relation("PostComments", fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies PostComment[] @relation("PostCommentReplies")

  likes  PostCommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

/// Curtida em comentário: uma por pessoa.
model PostCommentLike {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("PostCommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

/// Denúncia de post: uma por pessoa e post. Quem revisa é o painel de administração (fase seguinte).
model PostReport {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  /// Decisão da gestão: DISMISSED (sem problema) ou ACTIONED (providência tomada).
  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  resolution     String?
  resolutionNote String?

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("PostReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([createdAt])
  @@index([resolvedAt])
}

/// "Não tenho interesse": o post some das listas dessa pessoa.
model PostHidden {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostHidden", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostTag {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, status])
}

/// Convite para um evento criado por uma pessoa: quem foi marcado na criação ou recebeu o cartão do evento numa conversa.
/// Vale o primeiro convite (quem convidou primeiro fica registrado). Em evento privado, é o convite que abre o evento.
model EventInvite {
  postId      String   @db.Uuid
  userId      String   @db.Uuid
  invitedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  post      Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User  @relation("EventInvitesReceived", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("EventInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@id([postId, userId])
  @@index([userId])
}

/// Admin de um evento criado por pessoa: o dono promove quem vai (ou aceitou o convite) e pode tirar depois. O dono continua dono.
/// O admin convida (também em evento privado), cancela os convites que mandou e edita o evento; não apaga, não arquiva nem muda quem vê.
model EventAdmin {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  /// Quem promoveu (o dono). Sem chave estrangeira: só para registro.
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("EventAdmins", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

// "Eu vou": presença confirmada num evento do local (placeEventId) ou num evento criado por uma pessoa (postId). Exatamente um dos dois.
model EventAttendance {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  placeEventId String?  @db.Uuid
  postId       String?  @db.Uuid
  createdAt    DateTime @default(now())
  /// A pessoa escolheu, no "Eu vou", mostrar este evento na aba Eventos do perfil. Falso: fica só na aba Participou, que só ela vê.
  onProfile    Boolean  @default(false)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeEvent PlaceEvent? @relation(fields: [placeEventId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, placeEventId])
  @@unique([userId, postId])
  @@index([placeEventId, createdAt])
  @@index([postId, createdAt])
}

/// Story de um evento: foto ou vídeo, 24 h no ar e some junto com o evento (o fim do evento vira `expiresAt` se vier antes).
model EventStory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  placeEventId String?  @db.Uuid
  postId       String?  @db.Uuid
  mime         String
  isVideo      Boolean  @default(false)
  /// A pessoa escolheu publicar também no perfil: aparece na página inicial dos amigos (além do evento).
  onProfile    Boolean  @default(false)
  /// Textos e figurinhas por cima da mídia (lista conferida por `parseStoryOverlays`). Quem assiste desenha.
  overlays     Json?
  /// Texto que a pessoa escreveu sobre a mídia (como no Instagram). Null se publicou só a foto/vídeo.
  caption      String?
  /// Altura do texto na tela do story: 0 (topo) a 1 (pé).
  captionY     Float?
  data         Bytes
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user       User        @relation("EventStoryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  placeEvent PlaceEvent? @relation(fields: [placeEventId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)

  reports    EventStoryReport[]
  likes      EventStoryLike[]
  views      EventStoryView[]

  @@index([placeEventId, expiresAt])
  @@index([postId, expiresAt])
  @@index([userId])
  @@index([userId, onProfile, expiresAt])
}

/// Curtida (coração) num story, como no Instagram: uma por pessoa. Some junto com o story.
model EventStoryLike {
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  story EventStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User       @relation("EventStoryLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

/// Visualização de um story: uma por pessoa (a primeira vez que abriu). Só quem publicou vê a contagem. Some junto com o story.
model EventStoryView {
  storyId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  story EventStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User       @relation("EventStoryViews", fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

/// Denúncia de story: uma por pessoa. Fica guardada para a gestão; quem denunciou deixa de ver aquele story.
model EventStoryReport {
  id         String   @id @default(uuid()) @db.Uuid
  storyId    String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  /// Decisão da gestão: DISMISSED (sem problema) ou ACTIONED (providência tomada).
  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  resolution     String?
  resolutionNote String?

  story    EventStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporter User       @relation("EventStoryReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([storyId, reporterId])
  @@index([reporterId])
  @@index([resolvedAt])
}

/// Chaves que a gestão liga e desliga pelo painel, sem reiniciar o servidor (ex.: `payments.enabled`).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime
  /// Quem mudou por último. Sem chave estrangeira: sobrevive à remoção da conta.
  updatedBy String?  @db.Uuid
}

/// Registro de tudo que a gestão decidiu. Só cresce; `adminId` não tem chave estrangeira para sobreviver à remoção da conta.
/// Auditoria: o que a gestão decidiu, ações sensíveis de quem usa o app e do sistema. Só cresce.
model AdminAudit {
  id          String   @id @default(uuid()) @db.Uuid
  /// Quem fez. Nulo quando foi o sistema (pagamento confirmado, script).
  adminId     String?  @db.Uuid
  /// ADMIN, USER ou SYSTEM.
  actorKind   String   @default("ADMIN")
  action      String
  targetType  String
  targetId    String
  /// Nome do alvo no momento (@usuário, local, evento): continua legível se o alvo for apagado.
  targetLabel String?
  /// O que mudou, campo a campo: [{ field, before, after }].
  changes     Json?
  note        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

/// Capa enviada pelo dono do local (JPEG/PNG/WebP até 256 KB), servida em `/place-events/:id/cover`.
model PlaceEventCover {
  eventId   String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  event PlaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// Capa do estabelecimento enviada do aparelho (JPEG/PNG/WebP até 256 KB), servida em `/venues/:id/cover`.
model VenueCover {
  venueId   String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

/// Quem segue um estabelecimento: os posts dele entram no feed. `notify` é o sininho: avisa de cada evento novo.
model VenueFollow {
  userId    String   @db.Uuid
  venueId   String   @db.Uuid
  notify    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@index([venueId])
  @@index([venueId, notify])
}

/// Nota de 1 a 5 estrelas que uma pessoa dá a um estabelecimento (uma por pessoa).
model VenueRating {
  userId    String   @db.Uuid
  venueId   String   @db.Uuid
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@index([venueId])
}

/// Código secreto do QR de check-in do local. Trocar o código invalida o QR antigo.
model VenueCheckinCode {
  venueId   String   @id @db.Uuid
  code      String
  updatedAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

/// "Estive aqui": check-in feito lendo o QR do local. Vale mais que a presença confirmada no ranking.
model VenueCheckin {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([venueId, userId, createdAt])
}

/// Logo do estabelecimento enviada do aparelho (JPEG/PNG/WebP até 128 KB), servida em `/venues/:id/logo`.
model VenueLogo {
  venueId   String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

/// "Encontrar a melhor data": votação de disponibilidade de um grupo (ou conversa 1 a 1) dentro de um intervalo de dias.
/// Datas são dias do calendário (AAAA-MM-DD) no fuso `timezone`. Ao finalizar, vira um encontro (`meetupId`).
model DatePoll {
  id                 String    @id @default(uuid()) @db.Uuid
  conversationId     String    @db.Uuid
  organizerId        String    @db.Uuid
  title              String
  /// BEST_DATE (vota os dias; hora fixa), BEST_TIME (dia já definido: vota os horários de `candidateTimes`) ou BEST_DATE_TIME (vota os dias e os horários).
  schedulingMode     String    @default("BEST_DATE")
  /// Horários (HH:MM) votados em BEST_TIME e BEST_DATE_TIME; vazio no BEST_DATE.
  candidateTimes     String[]  @default([])
  rangeStart         String    @db.VarChar(10)
  rangeEnd           String    @db.VarChar(10)
  durationMinutes    Int
  /// Início preferido (HH:MM) no fuso `timezone`; nulo = 19:00.
  preferredTimeStart String?   @db.VarChar(5)
  timezone           String
  votingDeadline     DateTime?
  /// Votação encerrada à mão por quem organiza (ou já passou do prazo). Nulo = aberta.
  votingClosedAt     DateTime?
  /// Quando os participantes foram avisados de que o prazo acabou. Nulo = ainda não avisou.
  deadlineNotifiedAt DateTime?
  /// UNANIMITY, MAJORITY ou MANUAL.
  confirmationPolicy String
  greenMin           Int       @default(80)
  orangeMin          Int       @default(50)
  minCoverage        Int       @default(50)
  /// VOTING, CONFIRMING, FINALIZED ou CANCELLED.
  status             String    @default("VOTING")
  finalProposalId    String?   @db.Uuid
  meetupId           String?   @db.Uuid
  /// Evento (post) criado a partir da data definida.
  eventPostId        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eventPost    Post?                 @relation("PollEventPost", fields: [eventPostId], references: [id], onDelete: SetNull)
  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organizer    User                  @relation("PollOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants DatePollParticipant[]
  votes        DatePollVote[]
  proposals    DatePollProposal[]

  @@index([conversationId, createdAt])
  @@index([organizerId])
}

model DatePollParticipant {
  pollId     String    @db.Uuid
  userId     String    @db.Uuid
  /// Quando a pessoa marcou "concluí minha votação".
  finishedAt DateTime?

  poll DatePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

/// Um voto por pessoa, votação e opção (a chave primária garante): o dia (AAAA-MM-DD) ou, nas votações com horário, o horário (HH:MM). Sem linha = sem resposta.
model DatePollVote {
  pollId        String   @db.Uuid
  userId        String   @db.Uuid
  candidateDate String   @db.VarChar(10)
  /// YES (posso), MAYBE (talvez) ou NO (não posso).
  status        String
  updatedAt     DateTime @default(now())

  poll DatePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId, candidateDate])
  @@index([userId])
}

/// Data candidata enviada para confirmação, com a foto dos números na hora do envio.
model DatePollProposal {
  id             String   @id @default(uuid()) @db.Uuid
  pollId         String   @db.Uuid
  candidateDate  String   @db.VarChar(10)
  candidateStartAt DateTime
  candidateEndAt   DateTime
  compatibilityScore Float?
  coverageScore  Int
  availableCount Int
  maybeCount     Int
  unavailableCount Int
  unansweredCount Int
  /// OPEN, CONFIRMED, REJECTED ou WITHDRAWN.
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  poll          DatePoll                @relation(fields: [pollId], references: [id], onDelete: Cascade)
  confirmations DatePollConfirmation[]

  @@index([pollId, createdAt])
}

model DatePollConfirmation {
  proposalId String   @db.Uuid
  pollId     String   @db.Uuid
  userId     String   @db.Uuid
  /// CONFIRMED, ADJUST (preciso ajustar a agenda) ou DECLINED.
  status     String
  respondedAt DateTime

  proposal DatePollProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([proposalId, userId])
  @@index([pollId])
}

/// Conta de outra plataforma (Google, Apple) ligada a uma conta do AskouT. Liga pelo ID fixo da plataforma (`subject`), nunca pelo e-mail ou nome.
model ExternalIdentity {
  provider  String
  subject   String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subject])
  @@index([userId])
}

/// Lembrete de evento já mandado a uma pessoa (uma vez por pessoa, evento e tipo). Sem chave estrangeira: guarda só o marcador.
model EventReminder {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @db.Uuid
  source  String
  eventId String   @db.Uuid
  /// Qual lembrete (ver apps/api/src/core/event-reminders.ts): `1d`, `manha`, `2h`, `1h`, `30m` ou `15m`.
  kind    String   @default("30m")
  sentAt  DateTime

  @@unique([userId, source, eventId, kind])
  @@index([sentAt])
}

/// Lembretes que a pessoa escolheu só para um evento (no lugar da escolha geral). Sem chave estrangeira para o evento.
model EventReminderChoice {
  userId    String   @db.Uuid
  source    String
  eventId   String   @db.Uuid
  /// Lista separada por vírgula (`manha,30m`); vazio = nenhum lembrete neste evento.
  reminders String
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, source, eventId])
  @@index([source, eventId])
}

/// Impulsionamento: anúncio pago por quem administra o local (a página ou um evento dele).
model Boost {
  id          String    @id @default(uuid()) @db.Uuid
  venueId     String    @db.Uuid
  ownerId     String    @db.Uuid
  /// 'WEB' (Pix/cartão no provedor), 'APPLE' ou 'GOOGLE' (compra dentro do app, recibo conferido no servidor).
  channel     String    @default("WEB")
  /// 'VENUE' ou 'EVENT'.
  target      String
  /// Só quando target = EVENT. Sem chave estrangeira: se o evento sumir, o pedido pago continua registrado.
  eventId     String?   @db.Uuid
  days        Int
  amountCents Int
  /// 'PENDING_PAYMENT', 'PAID', 'CANCELLED' ou 'PAUSED'.
  status      String
  chargeId    String?   @unique
  payCode     String?
  payUrl      String?
  createdAt   DateTime
  paidAt      DateTime?
  startsAt    DateTime?
  endsAt      DateTime?
  /// 'ALL' (destaque para todos) ou 'MATCH' (só quem mora no raio e tem o gosto validado).
  audience    String    @default("ALL")
  /// Só no Match: raio em metros em volta do local.
  radiusM     Int?
  /// Só no Match: hashtags do evento que o responsável quer alcançar.
  matchTags   String[]  @default([])

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stats BoostDailyStat[]
  seen  BoostSeen[]

  @@index([venueId, createdAt])
  @@index([status, startsAt, endsAt])
}

/// Relatório do anúncio: contador por dia, lugar do app e tipo. Só números, nunca quem.
model BoostDailyStat {
  boostId   String @db.Uuid
  /// Data no fuso de Brasília (AAAA-MM-DD).
  day       String
  /// 'EXPLORE', 'HOME', 'MATCH' ou 'EVENT_PAGE'.
  placement String
  /// 'IMPRESSION', 'OPEN' ou 'TICKET'.
  kind      String
  count     Int    @default(0)

  boost Boost @relation(fields: [boostId], references: [id], onDelete: Cascade)

  @@id([boostId, day, placement, kind])
}

/// "Já contei esta pessoa hoje neste anúncio": guarda só uma chave embaralhada (nunca o id) e é apagada em 2 dias.
model BoostSeen {
  boostId   String @db.Uuid
  day       String
  kind      String
  viewerKey String

  boost Boost @relation(fields: [boostId], references: [id], onDelete: Cascade)

  @@id([boostId, day, kind, viewerKey])
  @@index([day])
}

/// Oferta relâmpago do bar: texto curto com hora de fim, mostrada como "Patrocinado" a quem está perto.
/// Grátis por enquanto (ver GOLIVE.md). Uma no ar por local; o limite por dia é conferido pelo núcleo.
model VenueOffer {
  id        String    @id @default(uuid()) @db.Uuid
  venueId   String    @db.Uuid
  ownerId   String    @db.Uuid
  text      String
  createdAt DateTime
  startsAt  DateTime
  endsAt    DateTime
  /// Preenchido quando o responsável encerra antes do fim.
  endedAt   DateTime?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
  @@index([endsAt])
}

/// Quanto tempo um conteúdo ficou visível na tela da pessoa. Alimenta as recomendações da Home.
/// Dado de comportamento (LGPD): guardado por 60 dias, a pessoa pode desligar e apagar.
model ContentDwell {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// 'POST' ou 'EVENT'.
  targetType String
  /// Sem chave estrangeira: o conteúdo pode sumir e a medição continua até vencer o prazo.
  targetId   String
  ms         Int
  /// 'FEED', 'RECO' ou 'OTHER'.
  source     String
  /// Abriu o conteúdo a partir da exibição (clique no bloco "Para você").
  clicked    Boolean  @default(false)
  /// Compartilhou o conteúdo (conversa, fora do app ou no próprio perfil).
  shared     Boolean  @default(false)
  createdAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Região aproximada (coordenada arredondada, cerca de 1 km) que a própria pessoa informa para receber o Match.
/// Dado de localização (LGPD): opcional, a pessoa remove quando quiser e some junto com a conta.
model UserRegion {
  userId    String   @id @db.Uuid
  lat       Float
  lng       Float
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
}

/// Agenda (iCal / Google Agenda) ligada a um estabelecimento. O endereço é um segredo de quem administra.
model VenueCalendar {
  venueId   String    @id @db.Uuid
  url       String
  /// Com quantos dias de antecedência o evento sobe (1 a 30).
  leadDays  Int       @default(7)
  enabled   Boolean   @default(true)
  lastSyncAt DateTime?
  lastError String?
  lastFound Int       @default(0)
  createdAt DateTime

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([enabled, lastSyncAt])
}

/// Evento lido da agenda, esperando a aprovação do dono. Só vira PlaceEvent depois de aprovado e na data de subir.
model VenueCalendarDraft {
  id               String   @id @db.Uuid
  venueId          String   @db.Uuid
  /// `uid|início original`: identifica a ocorrência na agenda.
  occKey           String
  title            String
  description      String   @default("")
  startsAt         DateTime
  endsAt           DateTime
  kind             EventKind @default(OTHER)
  isFree           Boolean  @default(false)
  imageUrl         String?
  tags             String[] @default([])
  ticketUrl        String?
  publishAt        DateTime
  /// WAITING, AWAITING, APPROVED, PUBLISHED ou DISMISSED.
  status           String
  edited           Boolean  @default(false)
  notifiedAt       DateTime?
  publishedEventId String?
  createdAt        DateTime
  updatedAt        DateTime

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, occKey])
  @@index([status, publishAt])
  @@index([venueId, startsAt])
}

/// Quem publica no feed de um evento ou rolê: todos que veem a página, todos com aprovação do dono, ou só o dono.
enum FeedPolicy {
  OPEN
  MODERATED
  OWNER_ONLY
}

/// POST: foto ou texto do rolê. NOTICE: aviso (aparece destacado e, vindo do dono, avisa quem vai/segue).
enum FeedPostKind {
  POST
  NOTICE
}

enum FeedPostStatus {
  PUBLISHED
  PENDING
}

/// Publicação no feed de um evento (do local ou criado por uma pessoa) ou de um rolê. Exatamente um dos três alvos.
model FeedPost {
  id           String         @id @default(uuid()) @db.Uuid
  authorId     String         @db.Uuid
  placeEventId String?        @db.Uuid
  userEventId  String?        @db.Uuid
  venueId      String?        @db.Uuid
  kind         FeedPostKind   @default(POST)
  body         String?
  status       FeedPostStatus @default(PUBLISHED)
  /// Publicado pelo dono do rolê: a tela mostra o rolê no lugar da pessoa.
  asVenue      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?

  author     User        @relation("FeedPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  placeEvent PlaceEvent? @relation(fields: [placeEventId], references: [id], onDelete: Cascade)
  userEvent  Post?       @relation(fields: [userEventId], references: [id], onDelete: Cascade)
  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  images     FeedPostImage[]
  comments   FeedComment[]
  reactions  FeedReaction[]
  reports    FeedReport[]

  @@index([placeEventId, status, createdAt])
  @@index([userEventId, status, createdAt])
  @@index([venueId, status, createdAt])
  @@index([authorId])
}

/// Foto da publicação do feed (já reduzida pelo app, até 100 KB).
model FeedPostImage {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @db.Uuid
  position Int
  mime     String
  data     Bytes

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
}

/// Reação com emoji a uma publicação do feed: uma por pessoa.
model FeedReaction {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// Comentário numa publicação do feed (com @menções).
model FeedComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  /// Pode ser vazio quando o comentário é só um GIF.
  body      String
  createdAt DateTime @default(now())
  /// GIF da Giphy anexado: id e endereço (https, servidor da Giphy).
  gifId     String?
  gifUrl    String?
  /// Resposta a outro comentário: sempre o comentário de cima da conversa (um nível só). Apagar o de cima solta as respostas.
  parentId  String?  @db.Uuid

  post      FeedPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User                  @relation("FeedCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    FeedComment?          @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   FeedComment[]         @relation("FeedCommentReplies")
  reactions FeedCommentReaction[]
  reports   FeedReport[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

/// Reação com emoji a um comentário do feed: uma por pessoa.
model FeedCommentReaction {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  comment FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("FeedCommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

/// Denúncia de uma publicação (POST) ou de um comentário (COMMENT) do feed de evento ou rolê.
/// `evidence` guarda o texto como estava na hora; `dedupeKey` (denunciante + publicação + comentário) impede repetir.
/// Apagar a publicação ou o comentário leva as denúncias junto, como nos stories.
model FeedReport {
  id             String    @id @default(uuid()) @db.Uuid
  dedupeKey      String    @unique
  kind           String // POST | COMMENT
  postId         String    @db.Uuid
  commentId      String?   @db.Uuid
  reporterId     String    @db.Uuid
  reportedUserId String    @db.Uuid
  reason         String
  details        String?
  evidence       String    @default("")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  resolution     String?
  resolutionNote String?

  post     FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User         @relation("FeedReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User         @relation("FeedReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([resolvedAt])
  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
}

/// Consentimentos opcionais (LGPD): cada vez que a pessoa liga ou desliga um uso dos dados.
/// Só cresce; o estado atual é o registro mais recente de cada finalidade.
model ConsentEvent {
  id      String   @id @db.Uuid
  /// Desempate quando dois registros têm o mesmo instante.
  seq     Int      @default(autoincrement())
  userId  String   @db.Uuid
  /// 'MARKETING_EMAIL' ou 'MARKETING_PUSH'.
  purpose String
  granted Boolean
  /// 'SIGNUP' ou 'SETTINGS'.
  source  String
  at      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

enum CloakroomStatus {
  ISSUED
  STORED
  RETURNED
  CANCELED
}

/// Chapelaria do evento (guarda-volumes). Sem linha, o evento não tem chapelaria.
model CloakroomSetting {
  placeEventId String   @id @db.Uuid
  enabled      Boolean  @default(true)
  /// Preço por item, em centavos, cobrado na porta. Nulo: grátis.
  priceCents   Int?
  /// Máximo de itens ao mesmo tempo. Nulo: sem limite.
  capacity     Int?
  note         String?
  updatedAt    DateTime @updatedAt

  placeEvent PlaceEvent @relation(fields: [placeEventId], references: [id], onDelete: Cascade)
}

/// Ticket da chapelaria: o participante pede, a equipe confere o código ao receber e ao devolver.
model CloakroomTicket {
  id           String          @id @default(uuid()) @db.Uuid
  placeEventId String          @db.Uuid
  userId       String          @db.Uuid
  /// Etiqueta sequencial dentro do evento.
  number       Int
  code         String
  description  String
  itemCount    Int             @default(1)
  status       CloakroomStatus @default(ISSUED)
  createdAt    DateTime        @default(now())
  storedAt     DateTime?
  returnedAt   DateTime?

  placeEvent PlaceEvent @relation(fields: [placeEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeEventId, code])
  @@unique([placeEventId, number])
  @@index([userId, createdAt])
}

/// Quem trouxe quem pelo link de convite. A chave é a pessoa convidada: só um convite por conta, que nunca troca.
/// `qualifiedAt` marca o retorno ao app em outro dia; só convites confirmados contam para o selo (ver GOLIVE.md).
model Referral {
  inviteeId   String    @id @db.Uuid
  inviterId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  qualifiedAt DateTime?

  invitee User @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter User @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
}

/// Toque no link de convite no celular sem o app, antes de ir para a loja. `networkKey` é o hash da rede de quem tocou
/// (nunca o IP). Serve para o convite sobreviver à instalação: quem se cadastra na mesma rede logo depois recebe a
/// sugestão de quem convidou e confirma. Sem chave estrangeira: dura poucos dias e é apagado a cada novo toque.
model InviteClick {
  id         String   @id @default(uuid()) @db.Uuid
  networkKey String
  inviterId  String   @db.Uuid
  createdAt  DateTime @default(now())

  @@index([networkKey, createdAt])
  @@index([createdAt])
}

/// Álbum do encontro: fotos só de quem foi. No NOW `refId` é o id do convite (sem chave estrangeira: o convite some em 24 h);
/// no evento é `PLACE:<id>` ou `USER:<id>`. Quem foi fica gravado em AlbumMember.
model Album {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  refId     String
  title     String?
  placeName String?
  startedAt DateTime
  createdAt DateTime @default(now())

  members AlbumMember[]
  photos  AlbumPhoto[]

  @@unique([kind, refId])
  @@index([startedAt])
}

model AlbumMember {
  albumId      String    @db.Uuid
  userId       String    @db.Uuid
  joinedAt     DateTime  @default(now())
  /// Quando o aviso "Ontem em..." saiu para esta pessoa (nunca sai duas vezes).
  summarizedAt DateTime?

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([albumId, userId])
  @@index([userId])
}

model AlbumPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  albumId   String   @db.Uuid
  authorId  String   @db.Uuid
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  album  Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt])
  @@index([authorId])
}

/// Story público de um local verificado (com responsável): foto ou vídeo, 24 h. Quem segue vê na Home; o Explorar mostra na faixa "Rolando agora".
model VenueStory {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @db.Uuid
  authorId  String   @db.Uuid
  mime      String
  isVideo   Boolean  @default(false)
  data      Bytes
  createdAt DateTime @default(now())
  expiresAt DateTime

  venue   Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  author  User               @relation("VenueStoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reports VenueStoryReport[]

  @@index([venueId, expiresAt])
  @@index([expiresAt])
}

/// Denúncia de story de local: uma por pessoa. Denúncias abertas de várias pessoas suspendem a publicação do local até a gestão decidir.
model VenueStoryReport {
  id         String   @id @default(uuid()) @db.Uuid
  storyId    String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  /// Decisão da gestão: DISMISSED (sem problema) ou ACTIONED (providência tomada).
  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  resolution     String?
  resolutionNote String?

  story    VenueStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporter User       @relation("VenueStoryReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([storyId, reporterId])
  @@index([reporterId])
  @@index([resolvedAt, createdAt])
}

/// "Não tenho interesse": a pessoa não vê mais o local na Home nem no "Rolando agora".
model VenueStoryMute {
  userId    String   @db.Uuid
  venueId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
}

/// Preferência de quem vê: não ver stories de locais. Sem linha = vê.
model VenueStoryPref {
  userId  String  @id @db.Uuid
  hideAll Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Lista VIP de um evento de local (sem pagamento): ligada por quem administra o local.
model GuestList {
  eventId       String   @id @db.Uuid
  /// Quantos nomes cabem (sem contar acompanhantes). Nulo: sem limite.
  limit         Int?
  /// Depois deste horário ninguém entra. Nulo: até o fim do evento.
  closesAt      DateTime?
  maxCompanions Int      @default(0)
  createdAt     DateTime @default(now())

  event   PlaceEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries GuestListEntry[]
}

/// Um nome na lista VIP. O dono do local vê o nome e o @usuário (ponto de privacidade no GOLIVE.md).
model GuestListEntry {
  eventId     String    @db.Uuid
  userId      String    @db.Uuid
  companions  Int       @default(0)
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  list GuestList @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

/// Ponte com o AskouT Hunter (sistema separado). Cada evento que o Hunter cadastrou fica ligado aqui pela referência dele (`ref`).
/// Apagar este modelo e o módulo `hunter` desliga a ponte; os eventos continuam como eventos normais dos locais.
model HunterEventLink {
  ref       String     @id
  eventId   String     @unique @db.Uuid
  venueId   String     @db.Uuid
  createdAt DateTime   @default(now())

  event PlaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([venueId])
}

/// Lista de compras e divisão de gastos de um evento criado por uma pessoa (nunca de local). Quem criou o evento liga;
/// quem está no grupo do evento participa. Apagar o evento apaga tudo.
model EventShopping {
  eventPostId      String   @id @db.Uuid
  /// Quem participa (sem administrar) pode criar e acrescentar itens.
  membersCanAdd    Boolean  @default(true)
  /// Quem participa (sem administrar) pode marcar item como comprado.
  membersCanCheck  Boolean  @default(true)
  /// Ids de quem fica fora da divisão dos gastos (por padrão todo mundo do grupo entra).
  splitExcludedIds Json     @default("[]")
  createdAt        DateTime @default(now())

  eventPost Post                @relation(fields: [eventPostId], references: [id], onDelete: Cascade)
  items     EventShoppingItem[]
  expenses  EventExpense[]
}

/// Item da lista de compras. Pessoas ligadas só pelo id: quem apaga a conta some do nome, o item fica.
model EventShoppingItem {
  id          String    @id @default(uuid()) @db.Uuid
  eventPostId String    @db.Uuid
  title       String
  quantity    String?
  createdById String    @db.Uuid
  boughtById  String?   @db.Uuid
  boughtAt    DateTime?
  createdAt   DateTime  @default(now())

  shopping EventShopping @relation(fields: [eventPostId], references: [eventPostId], onDelete: Cascade)

  @@index([eventPostId, createdAt])
}

/// Gasto da divisão: anexo (nota fiscal, recibo) enviado por quem participa, ou lançado sem anexo por quem administra.
/// Quem administra informa o valor (centavos) e quem pagou. Pessoas ligadas só pelo id: a conta do grupo não muda se alguém apagar a conta.
model EventExpense {
  id          String   @id @default(uuid()) @db.Uuid
  eventPostId String   @db.Uuid
  uploaderId  String   @db.Uuid
  fileName    String?
  mime        String?
  size        Int      @default(0)
  data        Bytes?
  amountCents Int?
  payerId     String?  @db.Uuid
  note        String?
  createdAt   DateTime @default(now())

  shopping EventShopping @relation(fields: [eventPostId], references: [eventPostId], onDelete: Cascade)

  @@index([eventPostId, createdAt])
}

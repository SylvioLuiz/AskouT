// AskouT — modelo de dados (Fases 1 e 2). Posts, locais/eventos e moderação entram em migrations próprias.
// ATENÇÃO: ainda não validado com `prisma validate` (sem rede no ambiente de geração).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
}

enum UserRole {
  USER
  VENUE_OWNER
  ADMIN
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum AvailabilityState {
  AVAILABLE
  PARTIAL
  UNAVAILABLE
}

enum CalendarProvider {
  GOOGLE
  APPLE
}

enum CalendarConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum MeetingStatus {
  PLANNING
  CONFIRMED
  CANCELLED
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  MAYBE
  DECLINED
  AWAITING
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum FlashInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
  ENDED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum EventKind {
  DIGITAL
  SHOW
  CINEMA
  THEATER
  EXHIBITION
  GASTRONOMY
  NIGHT
  OUTDOOR
  SPORT
  OTHER
}

enum SuggestionResponse {
  ACCEPTED
  DECLINED
}

/// Bytes de uma mensagem de voz (até 600 KB; a API confere antes). Só quem está na conversa consegue ouvir.
/// Foto ou vídeo enviado na conversa (kind IMAGE ou VIDEO).
model MessageMedia {
  messageId String @id @db.Uuid
  mime      String
  data      Bytes

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

/// Reação com emoji a uma mensagem: uma por pessoa.
model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageAudio {
  messageId String @id @db.Uuid
  mime      String
  data      Bytes

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum MessageKind {
  TEXT
  SUGGESTION
  MEETUP
  SYSTEM
  EVENT
  AUDIO
  IMAGE
  VIDEO
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile  Profile?
  settings UserSettings?

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")
  datePollsOrganized     DatePoll[]             @relation("PollOrganizer")
  datePollParticipations DatePollParticipant[]
  datePollVotes          DatePollVote[]
  datePollConfirmations  DatePollConfirmation[]

  blocksMade Block[] @relation("Blocker")
  blockedBy  Block[] @relation("Blocked")

  availabilitySlots   AvailabilitySlot[]
  calendarConnections CalendarConnection[]
  externalIdentities  ExternalIdentity[]

  organizedMeetings     Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]

  ownedGroups  Group[]       @relation("GroupOwner")
  groupMembers GroupMember[]

  conversationParticipations ConversationParticipant[]
  messages                   Message[]
  messageReactions           MessageReaction[]

  flashSessions       FlashSession[]
  flashInvitesSent    FlashInvite[]   @relation("FlashInviteFrom")
  flashInvitesReceived FlashInvite[]  @relation("FlashInviteTo")
  flashPositions      FlashPosition[]
  flashHides          FlashHidden[]   @relation("FlashHiddenOwner")
  flashHiddenFrom     FlashHidden[]   @relation("FlashHiddenOther")
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  postedEvents      PostedEvent[]
  postedUserEvents  PostedUserEvent[] @relation("UserPostedUserEvents")
  photo             ProfilePhoto?
  posts             Post[]
  eventAttendances  EventAttendance[]
  eventPosts        EventPost[]       @relation("EventPostAuthor")
  postTags          PostTag[]
  postLikes         PostLike[]    @relation("PostLikes")
  postComments      PostComment[] @relation("PostComments")
  postReports       PostReport[]  @relation("PostReports")
  conversationReports  ConversationReport[] @relation("ConversationReports")
  conversationReported ConversationReport[] @relation("ConversationReported")
  postHidden        PostHidden[]  @relation("PostHidden")
  ownedVenues       Venue[]       @relation("VenueOwner")
  venueClaims       VenueClaim[]  @relation("ClaimUser")
  venueFollows      VenueFollow[]
  venueRatings      VenueRating[]
  reviewedClaims    VenueClaim[]  @relation("ClaimReviewer")
}

model Profile {
  userId      String  @id @db.Uuid
  username    String  @unique // sempre salvo em minúsculas pela aplicação
  displayName String
  bio         String?
  avatarUrl   String?
  isPrivate   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  userId       String @id @db.Uuid
  timeZone     String @default("America/Sao_Paulo")
  notifyPrefs  Json   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId String       @db.Uuid
  followeeId String       @db.Uuid
  status     FollowStatus @default(ACCEPTED)
  createdAt  DateTime     @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model AvailabilitySlot {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  state          AvailabilityState
  recurrenceRule String? // RRULE; expandida antes de chamar o motor
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

model CalendarConnection {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @db.Uuid
  provider       CalendarProvider
  status         CalendarConnectionStatus @default(ACTIVE)
  refreshTokenEnc String? // criptografado em repouso; nunca em texto puro
  lastSyncAt     DateTime?
  createdAt      DateTime                 @default(now())

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  busyIntervals CalendarBusyInterval[]

  @@index([userId])
}

// Somente início e fim. Nunca título, descrição ou participantes do compromisso.
model CalendarBusyInterval {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startsAt])
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members GroupMember[]
  meetings Meeting[]
  conversation Conversation?
}

model GroupMember {
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  organizerId String        @db.Uuid
  groupId     String?       @db.Uuid
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      MeetingStatus @default(PLANNING)
  /// Evento do AskouT a que o encontro está ligado (nulo se o evento for apagado; título e horário ficam aqui).
  eventId        String?    @db.Uuid
  /// Conversa onde o encontro vive: a 1 a 1 (um convidado) ou a do grupo (vários).
  conversationId String?    @db.Uuid
  /// Evento criado por uma pessoa (post) de onde o encontro saiu. Liga pelo ID, nunca pelo nome: o nome pode mudar.
  eventPostId    String?    @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  eventPost    Post?                @relation("MeetingEventPost", fields: [eventPostId], references: [id], onDelete: SetNull)
  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  event        PlaceEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages     Message[]
  participants MeetingParticipant[]
  dateOptions  MeetingDateOption[]

  @@index([organizerId])
  @@index([groupId])
  @@index([eventId])
  @@index([eventPostId])
  @@index([conversationId])
}

model MeetingParticipant {
  meetingId String              @db.Uuid
  userId    String              @db.Uuid
  status    ParticipationStatus @default(INVITED)
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId, status])
}

model MeetingDateOption {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Conversation {
  id      String           @id @default(uuid()) @db.Uuid
  type    ConversationType
  groupId String?          @unique @db.Uuid
  /// Só nas conversas DIRECT: "<menor id>:<maior id>" da dupla, para existir uma única conversa por par.
  directKey String?        @unique
  createdAt DateTime       @default(now())

  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  meetings     Meeting[]
  datePolls    DatePoll[]
  reports      ConversationReport[]
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  /// "Limpar conversa": mensagens até esse instante não aparecem para essa pessoa.
  clearedAt      DateTime?
  /// Conversa fixada no topo da lista (só para essa pessoa).
  pinnedAt       DateTime?
  /// Sem avisos de mensagem nova (só para essa pessoa).
  muted          Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

/// Denúncia de conversa. `evidence` guarda as últimas mensagens de texto, só para a análise da equipe.
model ConversationReport {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  reporterId     String   @db.Uuid
  reportedUserId String?  @db.Uuid
  reason         String
  details        String?
  evidence       String   @default("")
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?  @db.Uuid
  resolution     String?
  resolutionNote String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ConversationReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reported     User?        @relation("ConversationReported", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, reporterId])
  @@index([createdAt])
  @@index([resolvedAt])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  kind           MessageKind @default(TEXT)
  body           String
  /// Cartão de sugestão de lugar/evento (kind = SUGGESTION); texto simples em `body` serve de reserva.
  suggestion     Json?
  /// Resposta de quem recebeu o cartão (aceitar ou recusar o lugar). Nula enquanto não respondeu.
  response       SuggestionResponse?
  respondedAt    DateTime?
  /// Cartão de encontro (kind = MEETUP).
  meetupId       String?  @db.Uuid
  /// Evento compartilhado na conversa (kind = EVENT).
  eventId        String?  @db.Uuid
  /// Evento criado por uma pessoa (um post), compartilhado na conversa (kind = EVENT, no lugar de eventId).
  postEventId    String?  @db.Uuid
  /// Duração da mensagem de voz em ms (kind = AUDIO); os bytes ficam em MessageAudio.
  audioMs        Int?
  /// Mensagem respondida (na mesma conversa).
  replyToId      String?  @db.Uuid
  /// Apagada por quem enviou: some para todos.
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  audio        MessageAudio?
  media        MessageMedia?
  reactions    MessageReaction[]
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  meetup       Meeting?     @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  event        PlaceEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postEvent    Post?        @relation("MessagePostEvent", fields: [postEventId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([postEventId])
  @@index([eventId])
  @@index([meetupId])
}

model FlashSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startsAt  DateTime  @default(now())
  expiresAt DateTime // obrigatório: todo Flash expira
  endedAt   DateTime? // preenchido quando a pessoa desliga antes do fim
  note      String? // recado curto opcional

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// Convite entre dois amigos com Flash ligado. ACCEPTED é o encontro: só nele a posição é compartilhada.
model FlashInvite {
  id          String            @id @default(uuid()) @db.Uuid
  fromUserId  String            @db.Uuid
  toUserId    String            @db.Uuid
  status      FlashInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  endedAt     DateTime?

  from      User            @relation("FlashInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User            @relation("FlashInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  positions FlashPosition[]

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

// Última posição de cada pessoa num encontro. Sem histórico: o upsert substitui a anterior.
model FlashPosition {
  inviteId  String   @db.Uuid
  userId    String   @db.Uuid
  lat       Float
  lng       Float
  accuracyM Float?
  updatedAt DateTime

  invite FlashInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
}

// Ocultação do Flash entre duas pessoas, do ponto de vista de `ownerId`: não ver o Flash dela e/ou não deixar ela ver o meu.
model FlashHidden {
  ownerId    String   @db.Uuid
  otherId    String   @db.Uuid
  hideTheirs Boolean  @default(false)
  hideMine   Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner User @relation("FlashHiddenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  other User @relation("FlashHiddenOther", fields: [otherId], references: [id], onDelete: Cascade)

  @@id([ownerId, otherId])
  @@index([otherId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Foto de perfil enviada pela pessoa (já reduzida pelo app). `Profile.avatarUrl` aponta para /users/:id/avatar.
model ProfilePhoto {
  userId    String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Evento que a pessoa decidiu postar no próprio perfil.
// Evento criado por outra pessoa que alguém repostou no próprio perfil.
model PostedUserEvent {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation("UserPostedUserEvents", fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model PostedEvent {
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event PlaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId, createdAt])
}

// Inscrição de um navegador/aparelho para Web Push. O endpoint é único: pertence a uma pessoa só.
model PushSubscription {
  endpoint  String   @id
  userId    String   @db.Uuid
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cadastro aguardando o código enviado por e-mail. A conta (User + Profile) só nasce na confirmação.
// Guarda hashes: nunca a senha nem o código. Linhas expiradas devem ser limpas por uma rotina periódica.
model PendingSignup {
  email        String   @id // minúsculo
  username     String
  displayName  String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0) // incrementar de forma atômica (attempts: { increment: 1 })
  sendCount    Int      @default(1)
  lastSentAt   DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// Local físico (bar, café, casa de show). Por enquanto cadastrado à mão ou por seed de TESTE (isSample);
/// o painel de bares passa a criar e editar isto.
model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  category  String?
  lat       Float
  lng       Float
  /// Dado de teste, nunca apresentado como real.
  isSample  Boolean  @default(false)
  /// Quem administra o local (pedido de reivindicação aprovado por um admin).
  ownerId   String?  @db.Uuid
  /// Perfil do estabelecimento (editável por quem administra).
  description String?
  /// JSON com 7 posições (domingo a sábado): {open, close} ou null (fechado).
  hoursJson   String?
  /// https ou `/venues/:id/cover?v=` (capa enviada, bytes em VenueCover).
  coverUrl    String?
  /// https ou `/venues/:id/logo?v=` (logo enviada, bytes em VenueLogo).
  logoUrl     String?
  /// "google:ID" quando o local entrou de uma fonte externa; único.
  externalKey String?  @unique
  photoRef    String?
  photoAuthor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User?        @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events PlaceEvent[]
  claims VenueClaim[]
  cover  VenueCover?
  logo   VenueLogo?
  followers VenueFollow[]
  ratings   VenueRating[]
  posts  Post[]
  comments PostComment[]

  @@index([lat, lng])
  @@index([ownerId])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pedido de uma pessoa para administrar um local. O documento (PDF ou imagem, até 2 MB) só o admin vê.
model VenueClaim {
  id           String      @id @default(uuid()) @db.Uuid
  venueId      String      @db.Uuid
  userId       String      @db.Uuid
  status       ClaimStatus @default(PENDING)
  note         String?
  documentMime String
  document     Bytes
  reviewNote   String?
  reviewedBy   String?     @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())

  venue    Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user     User  @relation("ClaimUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ClaimReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([venueId, status])
  @@index([status, createdAt])
}

/// Evento num local, com data e hora. Chamado PlaceEvent para não colidir com a palavra "Event" em outros contextos.
model PlaceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  kind        EventKind @default(OTHER)
  isFree      Boolean   @default(false)
  /// Endereço https de uma imagem fornecida por quem criou o evento (nunca copiada do Google).
  imageUrl    String?
  /// Hashtags em minúsculas, sem "#" e sem acento.
  tags        String[]  @default([])
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  meetings Meeting[]
  messages Message[]
  posts    PostedEvent[]
  attendees EventAttendance[]
  cover    PlaceEventCover?

  @@index([startsAt])
  @@index([venueId])
  @@index([kind])
}

// Post com fotos (enviadas pela pessoa ou a foto de um lugar) e legenda opcional.
model Post {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @db.Uuid
  caption      String?
  placeName    String?
  placeAddress String?
  /// Preenchidos quando o post é um evento criado pela pessoa.
  eventTitle    String?
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  eventKind     EventKind @default(OTHER)
  /// false (padrão): só o dono posta no evento; true: o dono e quem confirmou presença.
  eventPostsPublic Boolean @default(false)
  /// Evento privado: some das listas e do perfil de quem não é o dono; só chega por cartão enviado numa conversa e ninguém o reposta.
  eventPrivate     Boolean @default(false)
  archivedAt    DateTime?
  editedAt      DateTime?
  createdAt    DateTime @default(now())
  /// Post feito em nome de um estabelecimento (o autor é quem administra o local).
  venueId      String?  @db.Uuid

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  venue  Venue?      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  images PostImage[]
  tags   PostTag[]
  likes    PostLike[]
  comments PostComment[]
  reports  PostReport[]
  hiddenBy PostHidden[]
  attendees EventAttendance[]
  eventPosts EventPost[]
  sharedInMessages Message[] @relation("MessagePostEvent")
  repostedBy PostedUserEvent[]
  datePolls  DatePoll[] @relation("PollEventPost")
  meetings   Meeting[]  @relation("MeetingEventPost")

  @@index([authorId, createdAt])
  @@index([venueId, createdAt])
}

// Foto enviada: `mime` e `data`. Foto do lugar: só `placePhotoRef` (o servidor busca no Google na hora de mostrar).
model PostImage {
  id               String  @id @default(uuid()) @db.Uuid
  postId           String  @db.Uuid
  position         Int
  mime             String?
  data             Bytes?
  placePhotoRef    String?
  placePhotoAuthor String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
}

// Marcação de uma pessoa num post. Só vale no perfil e no feed dela depois que ela aceita.
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  /// Comentário feito como estabelecimento (quem administra, num post do próprio bar).
  venueId   String?  @db.Uuid

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  venue  Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  author User @relation("PostComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Denúncia de post: uma por pessoa e post. Quem revisa é o painel de administração (fase seguinte).
model PostReport {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  /// Decisão da gestão: DISMISSED (sem problema) ou ACTIONED (providência tomada).
  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  resolution     String?
  resolutionNote String?

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("PostReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([createdAt])
  @@index([resolvedAt])
}

/// "Não tenho interesse": o post some das listas dessa pessoa.
model PostHidden {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostHidden", fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostTag {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, status])
}

// "Eu vou": presença confirmada num evento do local (placeEventId) ou num evento criado por uma pessoa (postId). Exatamente um dos dois.
model EventAttendance {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  placeEventId String?  @db.Uuid
  postId       String?  @db.Uuid
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeEvent PlaceEvent? @relation(fields: [placeEventId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, placeEventId])
  @@unique([userId, postId])
  @@index([placeEventId, createdAt])
  @@index([postId, createdAt])
}

// Post dentro de um evento criado por uma pessoa: legenda e uma foto opcional (até 100 KB).
model EventPost {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  authorId  String   @db.Uuid
  caption   String
  mime      String?
  data      Bytes?
  createdAt DateTime @default(now())

  event  Post @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User @relation("EventPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

/// Registro de tudo que a gestão decidiu. Só cresce; `adminId` não tem chave estrangeira para sobreviver à remoção da conta.
model AdminAudit {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Capa enviada pelo dono do local (JPEG/PNG/WebP até 256 KB), servida em `/place-events/:id/cover`.
model PlaceEventCover {
  eventId   String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  event PlaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// Capa do estabelecimento enviada do aparelho (JPEG/PNG/WebP até 256 KB), servida em `/venues/:id/cover`.
model VenueCover {
  venueId   String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

/// Quem segue um estabelecimento: os posts dele entram no feed.
model VenueFollow {
  userId    String   @db.Uuid
  venueId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@index([venueId])
}

/// Nota de 1 a 5 estrelas que uma pessoa dá a um estabelecimento (uma por pessoa).
model VenueRating {
  userId    String   @db.Uuid
  venueId   String   @db.Uuid
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@index([venueId])
}

/// Logo do estabelecimento enviada do aparelho (JPEG/PNG/WebP até 128 KB), servida em `/venues/:id/logo`.
model VenueLogo {
  venueId   String   @id @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

/// "Encontrar a melhor data": votação de disponibilidade de um grupo (ou conversa 1 a 1) dentro de um intervalo de dias.
/// Datas são dias do calendário (AAAA-MM-DD) no fuso `timezone`. Ao finalizar, vira um encontro (`meetupId`).
model DatePoll {
  id                 String    @id @default(uuid()) @db.Uuid
  conversationId     String    @db.Uuid
  organizerId        String    @db.Uuid
  title              String
  schedulingMode     String    @default("BEST_DATE")
  rangeStart         String    @db.VarChar(10)
  rangeEnd           String    @db.VarChar(10)
  durationMinutes    Int
  /// Início preferido (HH:MM) no fuso `timezone`; nulo = 19:00.
  preferredTimeStart String?   @db.VarChar(5)
  timezone           String
  votingDeadline     DateTime?
  /// Votação encerrada à mão por quem organiza (ou já passou do prazo). Nulo = aberta.
  votingClosedAt     DateTime?
  /// Quando os participantes foram avisados de que o prazo acabou. Nulo = ainda não avisou.
  deadlineNotifiedAt DateTime?
  /// UNANIMITY, MAJORITY ou MANUAL.
  confirmationPolicy String
  greenMin           Int       @default(80)
  orangeMin          Int       @default(50)
  minCoverage        Int       @default(50)
  /// VOTING, CONFIRMING, FINALIZED ou CANCELLED.
  status             String    @default("VOTING")
  finalProposalId    String?   @db.Uuid
  meetupId           String?   @db.Uuid
  /// Evento (post) criado a partir da data definida.
  eventPostId        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eventPost    Post?                 @relation("PollEventPost", fields: [eventPostId], references: [id], onDelete: SetNull)
  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organizer    User                  @relation("PollOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants DatePollParticipant[]
  votes        DatePollVote[]
  proposals    DatePollProposal[]

  @@index([conversationId, createdAt])
  @@index([organizerId])
}

model DatePollParticipant {
  pollId     String    @db.Uuid
  userId     String    @db.Uuid
  /// Quando a pessoa marcou "concluí minha votação".
  finishedAt DateTime?

  poll DatePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

/// Um voto por pessoa, votação e dia (a chave primária garante). Dia sem linha = sem resposta.
model DatePollVote {
  pollId        String   @db.Uuid
  userId        String   @db.Uuid
  candidateDate String   @db.VarChar(10)
  /// YES (posso), MAYBE (talvez) ou NO (não posso).
  status        String
  updatedAt     DateTime @default(now())

  poll DatePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId, candidateDate])
  @@index([userId])
}

/// Data candidata enviada para confirmação, com a foto dos números na hora do envio.
model DatePollProposal {
  id             String   @id @default(uuid()) @db.Uuid
  pollId         String   @db.Uuid
  candidateDate  String   @db.VarChar(10)
  candidateStartAt DateTime
  candidateEndAt   DateTime
  compatibilityScore Float?
  coverageScore  Int
  availableCount Int
  maybeCount     Int
  unavailableCount Int
  unansweredCount Int
  /// OPEN, CONFIRMED, REJECTED ou WITHDRAWN.
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  poll          DatePoll                @relation(fields: [pollId], references: [id], onDelete: Cascade)
  confirmations DatePollConfirmation[]

  @@index([pollId, createdAt])
}

model DatePollConfirmation {
  proposalId String   @db.Uuid
  pollId     String   @db.Uuid
  userId     String   @db.Uuid
  /// CONFIRMED, ADJUST (preciso ajustar a agenda) ou DECLINED.
  status     String
  respondedAt DateTime

  proposal DatePollProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([proposalId, userId])
  @@index([pollId])
}

/// Conta de outra plataforma (Google, Apple) ligada a uma conta do AskouT. Liga pelo ID fixo da plataforma (`subject`), nunca pelo e-mail ou nome.
model ExternalIdentity {
  provider  String
  subject   String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subject])
  @@index([userId])
}
